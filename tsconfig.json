{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "outDir": "./task-api-backend/dist",
    "rootDir": "./task-api-backend/src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["task-api-backend/src/**/*"],
  "exclude": ["node_modules", "dist", "prisma/migrations", "prisma/config.ts"]
}